{
	"name": "adaptive-tab-bar-colour",
	"version": "4.3.1",
	"private": true,
	"description": "Changes the colour of Firefox theme to match the website’s appearance.",
	"homepage": "https://github.com/atbc-org/Adaptive-Tab-Bar-Colour",
	"bugs": {
		"url": "https://github.com/atbc-org/Adaptive-Tab-Bar-Colour/issues",
		"email": "me@easonwong.de"
	},
	"license": "MIT",
	"author": "Eason Wong <me@easonwong.de> (https://easonwong.de/)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atbc-org/Adaptive-Tab-Bar-Colour.git"
	},
	"type": "module",
	"scripts": {
		"build": "wxt build -b firefox",
		"format": "bun fmt",
		"lint": "bun fmt --check",
		"postinstall": "wxt prepare",
		"start": "cross-env BINARY=firefox wxt --mode beta",
		"start:dev": "cross-env BINARY=deved wxt --mode beta",
		"test": "bun test --max-concurrency 1 --timeout 60000",
		"test:headless": "cross-env HEADLESS=true bun test --max-concurrency 1 --timeout 60000",
		"typecheck": "tsc --noEmit",
		"zip": "bash scripts/zip.sh"
	},
	"dependencies": {
		"@wxt-dev/i18n": "^0.2.8",
		"clsx": "^2.1.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/selenium-webdriver": "^4.35.7",
		"@types/webextension-polyfill": "^0.12.6",
		"@wxt-dev/browser": "^0.3.7",
		"@wxt-dev/module-react": "^1.2.2",
		"cross-env": "^10.1.0",
		"geckodriver": "^8.0.0",
		"selenium-webdriver": "^4.52.0",
		"typescript": "^7.0.2",
		"web-ext": "^10.8.0",
		"wxt": "^0.21.5"
	}
}
