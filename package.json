{
	"name": "adaptive-tab-bar-colour",
	"version": "4.1.0",
	"description": "Changes the colour of Firefox theme to match the website’s appearance.",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "wxt build -b firefox",
		"format": "prettier --write --list-different .",
		"postinstall": "wxt prepare",
		"start": "cross-env BINARY=firefox wxt --mode beta",
		"start:dev": "cross-env BINARY=deved wxt --mode beta",
		"test": "tsx tests/run.ts",
		"zip": "bash scripts/zip.sh"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atbc-org/Adaptive-Tab-Bar-Colour.git"
	},
	"author": "Eason Wong <me@easonwong.de> (https://easonwong.de/)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/atbc-org/Adaptive-Tab-Bar-Colour/issues",
		"email": "me@easonwong.de"
	},
	"homepage": "https://github.com/atbc-org/Adaptive-Tab-Bar-Colour",
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/selenium-webdriver": "^4.35.6",
		"@types/webextension-polyfill": "^0.12.6",
		"@wxt-dev/browser": "^0.2.9",
		"@wxt-dev/module-react": "^1.2.2",
		"cross-env": "^10.1.0",
		"geckodriver": "^6.1.1",
		"prettier": "^3.9.6",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-jsdoc": "^1.8.1",
		"prettier-plugin-sort-json": "^4.2.0",
		"prettier-plugin-yaml": "^1.3.0",
		"selenium-webdriver": "^4.48.0",
		"selenium-webext-bridge": "^0.4.0",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"web-ext": "^10.6.0",
		"webextension-polyfill": "^0.12.0",
		"wxt": "^0.21.4"
	},
	"dependencies": {
		"@wxt-dev/i18n": "^0.2.7",
		"clsx": "^2.1.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	}
}
